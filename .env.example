# ─── Database ──────────────────────────────────────────
# Koneksi ke PostgreSQL lewat PgBouncer (transaction mode), bukan direct connection.
# Wajib menggunakan role mrp_service yang sudah memiliki scoped permissions.
MRP_DATABASE_URL=postgres://mrp_service:replace_with_secret@localhost:6432/erpdb
DB_MAX_CONNS=10                  # Max pool connections
DB_MIN_CONNS=2                   # Min idle pool connections
DB_CONN_TIMEOUT_SECONDS=10       # Timeout acquire connection dari pool

# ─── Redis ─────────────────────────────────────────────
# Instance Redis yang sama dengan NestJS backend (BullMQ queue).
REDIS_ADDR=localhost:6379
# REDIS_URL=redis://localhost:6379 # Alternatif format jika menggunakan URI
REDIS_QUEUE_NAME=mrp-calculation # Wajib persis "mrp-calculation" (sinkron dengan NestJS)

# ─── MRP Calculation Settings ──────────────────────────
MRP_MAX_BOM_DEPTH=10             # Proteksi circular BOM (max recursive levels)
MRP_DEFAULT_LEAD_TIME_DAYS=7     # Fallback lead time purchase jika data variant kosong (default 7 hari)
MRP_DEFAULT_PRODUCTION_DAYS=3    # Fallback lead time produksi jika BOM operations kosong (default 3 hari)
MRP_MIN_QUANTITY=0.001           # Toleransi floating point minimum quantity valid

# ─── Worker Settings ───────────────────────────────────
MRP_WORKER_CONCURRENCY=5         # Jumlah job yang diproses secara paralel
MRP_JOB_TIMEOUT_MINUTES=10       # Timeout per job kalkulasi
MRP_RETRY_ATTEMPTS=3             # Khusus retry internal koneksi DB yang putus (BUKAN retry level job BullMQ)

# ─── Logging & App ─────────────────────────────────────
LOG_LEVEL=info                   # debug | info | warn | error
LOG_FORMAT=json                  # json (production) | text (local development)
APP_ENV=development              # development | production
